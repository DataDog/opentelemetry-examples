#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'EOF'
Deploy all Astronomy Store workloads to Kubernetes.

Usage:
  DD_INSTALL_FLOW=upstream ./install-app
  DD_INSTALL_FLOW=ddot ROLLOUT_TIMEOUT=5m ./install-app
  DD_INSTALL_FLOW=ddot DD_AGENT_ENABLED=false ./install-app
  DD_INSTALL_FLOW=ddot IMAGE_PREFIX=ghcr.io/example/astronomy-store IMAGE_TAG=v1.2.3 ./install-app

If IMAGE_PREFIX/IMAGE_TAG are not set, they default to the values in .image-env (written by
`./build-images --push`), falling back to astronomy-store:latest.

DD_INSTALL_FLOW selects the checkout image matching the OpenTelemetry Kube Stack install flow
(same variable as guides/kubernetes/configuration/opentelemetry-kube-stack/install):
  upstream  checkout:<tag>-upstream-otel, OpenTelemetry Go compile-time instrumentation
  ddot      checkout:<tag>, Datadog Orchestrion (DDOT SDK for Go)
EOF
    exit 0
fi

if [[ $# -gt 0 ]]; then
    echo "Usage: IMAGE_PREFIX=<prefix> IMAGE_TAG=<tag> DD_INSTALL_FLOW=<upstream|ddot> ROLLOUT_TIMEOUT=<duration> $0" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NAMESPACE="astronomy-store"
ROLLOUT_TIMEOUT="${ROLLOUT_TIMEOUT:-3m}"

# Fall back to the prefix/tag last pushed by `./build-images --push`, if any, before
# applying the local-build defaults. Real env vars always win.
IMAGE_ENV_FILE="${SCRIPT_DIR}/.image-env"
if [[ -f "${IMAGE_ENV_FILE}" ]]; then
    while IFS='=' read -r key value; do
        case "${key}" in
            IMAGE_PREFIX) : "${IMAGE_PREFIX:=${value}}" ;;
            IMAGE_TAG) : "${IMAGE_TAG:=${value}}" ;;
        esac
    done < <(grep -v '^\s*#' "${IMAGE_ENV_FILE}" | grep -v '^\s*$')
fi

IMAGE_PREFIX="${IMAGE_PREFIX:-astronomy-store}"
IMAGE_PREFIX="${IMAGE_PREFIX%/}"
IMAGE_TAG="${IMAGE_TAG:-latest}"

case "${DD_INSTALL_FLOW:-}" in
    upstream) CHECKOUT_IMAGE_TAG="${IMAGE_TAG}-upstream-otel" ;;
    ddot) CHECKOUT_IMAGE_TAG="${IMAGE_TAG}" ;;
    *)
        echo "ERROR: DD_INSTALL_FLOW must be one of: upstream, ddot (got '${DD_INSTALL_FLOW:-}')" >&2
        exit 1
        ;;
esac

DD_AGENT_ENABLED="${DD_AGENT_ENABLED:-true}"
case "$DD_AGENT_ENABLED" in
    true|false) ;;
    *) echo "ERROR: DD_AGENT_ENABLED must be true or false" >&2; exit 1 ;;
esac

echo "Deploying images from ${IMAGE_PREFIX} with tag ${IMAGE_TAG} (checkout: ${CHECKOUT_IMAGE_TAG}, ${DD_INSTALL_FLOW} flow)."

SERVICE_MANIFESTS=(
    astronomy-db/kubernetes.yaml
    kafka/kubernetes.yaml
    ad/kubernetes.yaml
    product-catalog/kubernetes.yaml
    fraud-detection/kubernetes.yaml
    checkout/kubernetes.yaml
    frontend/kubernetes.yaml
)

OVERLAY_DIR="$(mktemp -d)"
cleanup() {
    rm -rf -- "${OVERLAY_DIR}"
}
trap cleanup EXIT

apply_service_manifest() {
    local manifest="$1"
    local service="${manifest%/kubernetes.yaml}"
    local service_overlay="${OVERLAY_DIR}/${service}"
    local tag="${IMAGE_TAG}"
    if [[ "${service}" == "checkout" ]]; then
        tag="${CHECKOUT_IMAGE_TAG}"
    fi

    mkdir -p "${service_overlay}"
    cp "${SCRIPT_DIR}/${manifest}" "${service_overlay}/kubernetes.yaml"
    cat > "${service_overlay}/kustomization.yaml" <<EOF
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - kubernetes.yaml
images:
  - name: astronomy-store/${service}
    newName: ${IMAGE_PREFIX}/${service}
    newTag: ${tag}
EOF

    kubectl apply -k "${service_overlay}"
}

kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -

if [[ "$DD_INSTALL_FLOW" == "ddot" && "$DD_AGENT_ENABLED" == "false" ]]; then
    kubectl get secret datadog-secret --namespace opentelemetry-operator-system \
      -o go-template='apiVersion: v1
kind: Secret
metadata:
  name: datadog-agentless-python
  namespace: astronomy-store
type: Opaque
data:
  api-key: {{index .data "api-key"}}
  dd-site: {{index .data "dd-site"}}
' | kubectl apply -f -
fi

for manifest in "${SERVICE_MANIFESTS[@]}"; do
    apply_service_manifest "${manifest}"
done

for deployment in astronomy-db kafka ad product-catalog fraud-detection checkout frontend; do
    kubectl rollout status "deployment/${deployment}" \
        --namespace "${NAMESPACE}" \
        --timeout="${ROLLOUT_TIMEOUT}"
done

kubectl apply -f "${SCRIPT_DIR}/load-generator/kubernetes.yaml"
kubectl rollout status deployment/k6-load-generator \
    --namespace "${NAMESPACE}" \
    --timeout="${ROLLOUT_TIMEOUT}"

echo "All Astronomy Store workloads are deployed to ${NAMESPACE}."
