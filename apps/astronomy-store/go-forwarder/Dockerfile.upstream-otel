FROM golang:1.25 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY *.go ./
RUN go install go.opentelemetry.io/otelc/tool/cmd/otelc@v1.1.0
RUN CGO_ENABLED=0 otelc go build -o /go-forwarder .

FROM gcr.io/distroless/static-debian12

COPY --from=build /go-forwarder /go-forwarder

ARG VCS_REPOSITORY_URL_FULL
ARG VCS_REF_HEAD_NAME
ARG VCS_REF_TYPE
ARG VCS_REF_HEAD_REVISION

ENV DD_GIT_REPOSITORY_URL=${VCS_REPOSITORY_URL_FULL}
ENV DD_GIT_COMMIT_SHA=${VCS_REF_HEAD_REVISION}

ENTRYPOINT ["/go-forwarder"]
