#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'EOF'
Build all Astronomy Store service images.

Usage:
  ./build-images
  ./build-images --push
  IMAGE_PREFIX=ghcr.io/example/astronomy-store IMAGE_TAG=v1.2.3 ./build-images --push

Without --push, builds locally with `docker build`.
With --push, builds with `docker buildx` and pushes to IMAGE_PREFIX.

Images are built for linux/amd64 only.

Env vars:
  IMAGE_PREFIX  Image name prefix (default: astronomy-store)
  IMAGE_TAG     Image tag (default: latest; git-sha based when pushing)
  BUILDER       buildx builder name, push only (default: astronomy-store)
EOF
    exit 0
fi

PUSH=0
if [[ "${1:-}" == "--push" ]]; then
    PUSH=1
    shift
fi

if [[ $# -gt 0 ]]; then
    echo "Usage: IMAGE_PREFIX=<prefix> IMAGE_TAG=<tag> $0 [--push]" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE_PREFIX="${IMAGE_PREFIX:-astronomy-store}"
IMAGE_PREFIX="${IMAGE_PREFIX%/}"
SERVICES=(ad checkout fraud-detection frontend product-catalog)

# Git metadata baked into each image as build args, then surfaced as OTel vcs.* / Datadog DD_GIT_*
# env vars inside the Dockerfiles. See the "VCS" ARG/ENV block near the end of each Dockerfile.
VCS_REPOSITORY_URL_FULL="$(git -C "${SCRIPT_DIR}" config --get remote.origin.url)"
VCS_REF_HEAD_NAME="$(git -C "${SCRIPT_DIR}" rev-parse --abbrev-ref HEAD)"
VCS_REF_TYPE="branch"
VCS_REF_HEAD_REVISION="$(git -C "${SCRIPT_DIR}" rev-parse HEAD)"
VCS_BUILD_ARGS=(
    --build-arg "VCS_REPOSITORY_URL_FULL=${VCS_REPOSITORY_URL_FULL}"
    --build-arg "VCS_REF_HEAD_NAME=${VCS_REF_HEAD_NAME}"
    --build-arg "VCS_REF_TYPE=${VCS_REF_TYPE}"
    --build-arg "VCS_REF_HEAD_REVISION=${VCS_REF_HEAD_REVISION}"
)

if [[ "${PUSH}" -eq 0 ]]; then
    IMAGE_TAG="${IMAGE_TAG:-latest}"

    for service in "${SERVICES[@]}"; do
        docker build "${VCS_BUILD_ARGS[@]}" --tag "${IMAGE_PREFIX}/${service}:${IMAGE_TAG}" "${SCRIPT_DIR}/${service}"
    done

    exit 0
fi

# --push path.

BUILDER="${BUILDER:-astronomy-store}"

if [[ -z "${IMAGE_TAG:-}" ]]; then
    if git -C "${SCRIPT_DIR}" rev-parse --short HEAD >/dev/null 2>&1; then
        IMAGE_TAG="$(git -C "${SCRIPT_DIR}" rev-parse --short HEAD)"
        if [[ -n "$(git -C "${SCRIPT_DIR}" status --porcelain -- "${SCRIPT_DIR}")" ]]; then
            IMAGE_TAG="${IMAGE_TAG}-dirty.$(date -u +%Y%m%d%H%M%S)"
        fi
    else
        IMAGE_TAG="$(date -u +%Y%m%d%H%M%S)"
    fi
fi

docker buildx inspect "${BUILDER}" >/dev/null 2>&1 || docker buildx create --name "${BUILDER}" --driver docker-container --bootstrap

for service in "${SERVICES[@]}"; do
    docker buildx build \
        --builder "${BUILDER}" \
        --platform linux/amd64 \
        "${VCS_BUILD_ARGS[@]}" \
        --tag "${IMAGE_PREFIX}/${service}:${IMAGE_TAG}" \
        --push \
        "${SCRIPT_DIR}/${service}"
done

cat > "${SCRIPT_DIR}/.image-env" <<EOF
# Generated by ./build-images --push. Consumed by ./install-app. Do not commit.
IMAGE_PREFIX=${IMAGE_PREFIX}
IMAGE_TAG=${IMAGE_TAG}
EOF
