#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'EOF'
Build all Astronomy Store service images.

Usage:
  ./build-images
  IMAGE_TAG=v1.2.3 ./build-images
  IMAGE_PREFIX=ghcr.io/example/astronomy-store IMAGE_TAG=v1.2.3 ./build-images
EOF
    exit 0
fi

if [[ $# -gt 0 ]]; then
    echo "Usage: IMAGE_PREFIX=<prefix> IMAGE_TAG=<tag> $0" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE_PREFIX="${IMAGE_PREFIX:-astronomy-store}"
IMAGE_PREFIX="${IMAGE_PREFIX%/}"
IMAGE_TAG="${IMAGE_TAG:-latest}"
SERVICES=(ad checkout fraud-detection frontend product-catalog)

# Git metadata baked into each image as build args, then surfaced as OCI image labels and Datadog
# DD_GIT_* env vars inside the Dockerfiles. See the "VCS" ARG/LABEL/ENV block near the end of each
# Dockerfile.
# Datadog Source Code Integration and org.opencontainers.image.source both expect a browsable https URL,
# so rewrite SSH remotes (git@github.com:org/repo.git, ssh://git@github.com/org/repo.git) to
# https://github.com/org/repo.
VCS_REPOSITORY_URL_FULL="$(git -C "${SCRIPT_DIR}" config --get remote.origin.url)"
VCS_REPOSITORY_URL_FULL="${VCS_REPOSITORY_URL_FULL%.git}"
if [[ "${VCS_REPOSITORY_URL_FULL}" =~ ^ssh://([^@/]+@)?([^/:]+)(:[0-9]+)?/(.+)$ ]]; then
    VCS_REPOSITORY_URL_FULL="https://${BASH_REMATCH[2]}/${BASH_REMATCH[4]}"
elif [[ "${VCS_REPOSITORY_URL_FULL}" =~ ^[^@/]+@([^:]+):(.+)$ ]]; then
    VCS_REPOSITORY_URL_FULL="https://${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
fi
VCS_REF_HEAD_NAME="$(git -C "${SCRIPT_DIR}" rev-parse --abbrev-ref HEAD)"
VCS_REF_TYPE="branch"
VCS_REF_HEAD_REVISION="$(git -C "${SCRIPT_DIR}" rev-parse HEAD)"
# org.opencontainers.image.version: the short commit SHA, as the image tag ("latest" by default) doesn't
# identify the content.
IMAGE_VERSION="$(git -C "${SCRIPT_DIR}" rev-parse --short HEAD)"
# org.opencontainers.image.created: the commit date in UTC rather than the build time, so rebuilding the
# same commit produces the same labels.
IMAGE_CREATED="$(TZ=UTC git -C "${SCRIPT_DIR}" log -1 --date=format-local:%Y-%m-%dT%H:%M:%SZ --format=%cd)"

for service in "${SERVICES[@]}"; do
    image="${IMAGE_PREFIX}/${service}:${IMAGE_TAG}"
    echo "Building ${image}..."
    docker build \
        --build-arg VCS_REPOSITORY_URL_FULL="${VCS_REPOSITORY_URL_FULL}" \
        --build-arg VCS_REF_HEAD_NAME="${VCS_REF_HEAD_NAME}" \
        --build-arg VCS_REF_TYPE="${VCS_REF_TYPE}" \
        --build-arg VCS_REF_HEAD_REVISION="${VCS_REF_HEAD_REVISION}" \
        --build-arg IMAGE_VERSION="${IMAGE_VERSION}" \
        --build-arg IMAGE_CREATED="${IMAGE_CREATED}" \
        --tag "${image}" "${SCRIPT_DIR}/${service}"
done

# checkout also has an alternate build using the upstream OTel otelc compiler instead of Datadog
# Orchestrion, published under the same image name with a "-upstream-otel" tag suffix.
upstream_otel_image="${IMAGE_PREFIX}/checkout:${IMAGE_TAG}-upstream-otel"
echo "Building ${upstream_otel_image}..."
docker build \
    --build-arg VCS_REPOSITORY_URL_FULL="${VCS_REPOSITORY_URL_FULL}" \
    --build-arg VCS_REF_HEAD_NAME="${VCS_REF_HEAD_NAME}" \
    --build-arg VCS_REF_TYPE="${VCS_REF_TYPE}" \
    --build-arg VCS_REF_HEAD_REVISION="${VCS_REF_HEAD_REVISION}" \
    --build-arg IMAGE_VERSION="${IMAGE_VERSION}" \
    --build-arg IMAGE_CREATED="${IMAGE_CREATED}" \
    --file "${SCRIPT_DIR}/checkout/Dockerfile.upstream-otel" \
    --tag "${upstream_otel_image}" "${SCRIPT_DIR}/checkout"

echo "Built ${#SERVICES[@]} images with tag ${IMAGE_TAG}, plus ${upstream_otel_image}."
