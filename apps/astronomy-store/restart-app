#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    cat <<'EOF'
Restart all Astronomy Store workloads on Kubernetes.

Usage:
  ./restart-app
  ROLLOUT_TIMEOUT=5m ./restart-app
EOF
    exit 0
fi

if [[ $# -gt 0 ]]; then
    echo "Usage: ROLLOUT_TIMEOUT=<duration> $0" >&2
    exit 1
fi

NAMESPACE="astronomy-store"
ROLLOUT_TIMEOUT="${ROLLOUT_TIMEOUT:-3m}"
DEPLOYMENTS=(kafka ad product-catalog fraud-detection checkout frontend k6-load-generator)

for deployment in "${DEPLOYMENTS[@]}"; do
    kubectl rollout restart "deployment/${deployment}" --namespace "${NAMESPACE}"
done

for deployment in "${DEPLOYMENTS[@]}"; do
    kubectl rollout status "deployment/${deployment}" \
        --namespace "${NAMESPACE}" \
        --timeout="${ROLLOUT_TIMEOUT}"
done

echo "All Astronomy Store workloads have been restarted in ${NAMESPACE}."
