{{- set . "Container" true }}
{{- set . "HelmPreset" true }}
{{- if .Preamble -}}
{{- if .Testing -}}
# FOR INTERNAL TESTING PURPOSES ONLY
{{end -}}
# values.yaml for the OpenTelemetry Collector Helm Chart (Deployment mode)
# Paired with {{- if .Testing}} otel-demo{{- if .DatadogExporter}}-datadog{{- end}}{{- else}} daemonset{{- end}}{{- if ne .CloudEnvironment ""}}-{{.CloudEnvironment}}{{- end}}.yaml to collect cluster level resources to support K8s Explorer
{{include "setup" .}}
# Required secrets: datadog-secrets::api-key
# Remember to modify DD_SITE if not using datadoghq.com
{{- if eq .CloudEnvironment ""}}
# Remember to set OTEL_K8S_CLUSTER_NAME with your actual cluster name
{{- end}}
{{- set . "Preamble" false}}
{{- end}}

extraEnvs:
  - name: DD_SITE
    value: datadoghq.com # Update if necessary
  - name: DD_API_KEY
    valueFrom:
      secretKeyRef:
        name: datadog-secrets
        key: api-key
{{- if eq .CloudEnvironment ""}}
  - name: OTEL_K8S_CLUSTER_NAME
    value: my-cluster-name # Update with your actual cluster name
{{- end}}

mode: deployment
image:
  repository: otel/opentelemetry-collector-contrib
  tag: {{.OtelcolVersion}}
command:
  name: "otelcol-contrib"

serviceAccount:
  create: true

# The clusterMetrics and kubernetesObjects presets configure the k8s_cluster and
# k8s_objects receivers and add the necessary ClusterRole rules.
presets:
  clusterMetrics:
    enabled: true
  kubernetesObjects:
    enabled: true
    watch: true
    autoscaling:
      vpa:
        # Enable this to collect VPAs (requires the VPA CRD to be pre-installed)
        enabled: false
{{- if and .Testing (eq .CloudEnvironment "eks")}}

clusterRole:
  create: true
  rules:
    # AWS custom resources collected by the k8s_objects receiver
    - apiGroups: ["networking.k8s.aws"]
      resources:
        - applicationnetworkpolicies
        - clusternetworkpolicies
        - clusterpolicyendpoints
        - policyendpoints
      verbs: ["get", "list", "watch"]
    - apiGroups: ["vpcresources.k8s.aws"]
      resources: ["cninodes", "securitygrouppolicies"]
      verbs: ["get", "list", "watch"]
    - apiGroups: ["crd.k8s.amazonaws.com"]
      resources: ["eniconfigs"]
      verbs: ["get", "list", "watch"]
{{- end}}

alternateConfig:
  {{ include "otelcol-k8s-objects" . | indent 2 }}
