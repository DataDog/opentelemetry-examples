# Datadog API key. Required.
export DD_API_KEY=xxxxxxx
# Installation flow: upstream or ddot. Required.
export DD_INSTALL_FLOW=upstream
# Datadog site. Default: datadoghq.com.
# export DD_SITE=datadoghq.com
# Kubernetes platform: eks, gcp, aks, or other. Default: other.
# export K8S_CLUSTER_TYPE=other
# Kubernetes cluster name. Default: auto-detected for eks, gcp, and aks; unset otherwise.
# export K8S_CLUSTER_NAME=
# Value of the deployment.environment.name resource attribute. Default: production.
# export DEPLOYMENT_ENVIRONMENT_NAME=production
# Install the Datadog Agent in the ddot flow: true or false. Default: true.
# export DD_AGENT_ENABLED=true
# Enable the eBPF host profiler: true or false. Requires Linux nodes with kernel >= 5.10. Default: false.
# export DD_HOST_PROFILER_ENABLED=false
# Host profiler egress NetworkPolicy: none, standard, or cilium. Default: none.
# export DD_HOST_PROFILER_NETWORK_POLICY=none
