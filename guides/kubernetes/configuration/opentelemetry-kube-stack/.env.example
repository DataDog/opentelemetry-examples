# Datadog API key. Required.
export DD_API_KEY=
# Datadog site. Default: datadoghq.com.
# export DD_SITE=datadoghq.com
# Kubernetes platform: eks, gcp, aks, or other. Default: other.
# export K8S_CLUSTER_TYPE=other
# Kubernetes cluster name. Default: auto-detected for eks, gcp, and aks; unset otherwise.
# export K8S_CLUSTER_NAME=
# Value of the deployment.environment.name resource attribute. Default: production.
# export DEPLOYMENT_ENVIRONMENT_NAME=production
