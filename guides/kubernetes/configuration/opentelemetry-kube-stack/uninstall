#!/usr/bin/env bash
set -euo pipefail

cat <<'EOF'
WARNING: This uninstall script is for development purposes only.

It deletes:
  - the cert-manager Helm release in the cert-manager namespace;
  - cert-manager CRDs: issuers, clusterissuers, certificates,
    certificaterequests, orders, and challenges;
  - the opentelemetry-kube-stack Helm release in the
    opentelemetry-operator-system namespace;
  - the host-profiler egress NetworkPolicy and CiliumNetworkPolicy in the
    opentelemetry-operator-system namespace (if installed);
  - the datadog DatadogAgent custom resource in the datadog namespace;
  - the datadog-agent-node-metadata supplementary ClusterRole/ClusterRoleBinding;
  - the datadog-operator Helm release in the datadog namespace;
  - the datadog-secret secret in the opentelemetry-operator-system and
    datadog namespaces;
  - OpenTelemetry CRDs: opentelemetrycollectors, instrumentations,
    opampbridges, and targetallocators;
  - Datadog Operator CRDs: datadogagents, datadogagentprofiles,
    datadogagentinternals, datadoginstrumentations, datadogmonitors,
    datadogslos, datadogdashboards, datadogmetrics, datadogcsidrivers,
    datadoggenericresources, datadogpodautoscalers, and
    datadogpodautoscalerclusterprofiles.

Deleting CRDs also deletes all corresponding custom resources in the cluster.
EOF

read -r -p "Type 'yes' to continue with the uninstall: " confirmation
if [[ "$confirmation" != "yes" ]]; then
  echo "Uninstall cancelled."
  exit 0
fi

helm uninstall cert-manager -n cert-manager \
   || echo "WARNING: Could not uninstall cert-manager. Continuing..."

kubectl delete crd \
  issuers.cert-manager.io \
  clusterissuers.cert-manager.io \
  certificates.cert-manager.io \
  certificaterequests.cert-manager.io \
  orders.acme.cert-manager.io \
  challenges.acme.cert-manager.io \
|| echo "WARNING: Could not uninstall cert-manager CRDs. Continuing..."

kubectl delete networkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  opentelemetry-kube-stack-host-profiler-egress \
  || echo "WARNING: Could not delete the host-profiler NetworkPolicy. Continuing..."
kubectl delete ciliumnetworkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  opentelemetry-kube-stack-host-profiler-egress \
  || echo "WARNING: CiliumNetworkPolicy CRD not installed. Continuing..."

helm uninstall opentelemetry-kube-stack \
  --namespace opentelemetry-operator-system  \
  || echo "WARNING: Could not uninstall opentelemetry-kube-stack. Continuing..."

# Remove the legacy standalone host-profiler Helm release (the pre-0.21.0 guide
# installed the profiler from the opentelemetry-collector chart).
helm uninstall host-profiler \
  --namespace opentelemetry-operator-system \
  || echo "WARNING: No legacy host-profiler Helm release. Continuing..."
kubectl delete networkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  host-profiler-egress \
  || echo "WARNING: Could not delete the legacy host-profiler NetworkPolicy. Continuing..."
kubectl delete ciliumnetworkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  host-profiler-egress \
  || echo "WARNING: CiliumNetworkPolicy CRD not installed. Continuing..."

kubectl delete datadogagent \
  --namespace datadog \
  --ignore-not-found=true \
  datadog \
  || echo "WARNING: Could not delete the datadog DatadogAgent custom resource. Continuing..."

kubectl delete clusterrolebinding --ignore-not-found=true datadog-agent-node-metadata \
  || echo "WARNING: Could not delete the datadog-agent-node-metadata ClusterRoleBinding. Continuing..."
kubectl delete clusterrole --ignore-not-found=true datadog-agent-node-metadata \
  || echo "WARNING: Could not delete the datadog-agent-node-metadata ClusterRole. Continuing..."

helm uninstall datadog-operator \
  --namespace datadog  \
  || echo "WARNING: Could not uninstall datadog-operator. Continuing..."

echo "Removing Datadog endpoint configuration..."
kubectl delete secrets --namespace opentelemetry-operator-system  --ignore-not-found=true datadog-secret
kubectl delete secrets --namespace datadog  --ignore-not-found=true datadog-secret


# Remove OpenTelemetry CRDs (optional - be careful as this affects all OpenTelemetry resources).
# CRDs are cluster-scoped, hence no --namespace. This is the full set installed by the
# opentelemetry-kube-stack chart's otel-crds subchart (crds.installOtel: true).
echo "Delete CRDs"
kubectl delete crd --ignore-not-found=true \
  opentelemetrycollectors.opentelemetry.io \
  instrumentations.opentelemetry.io \
  opampbridges.opentelemetry.io \
  targetallocators.opentelemetry.io \
  || echo "WARNING: Could not delete the OpenTelemetry Operator CRDs. Continuing..."

# Remove Datadog Operator CRDs (optional - be careful as this affects all Datadog Operator
# resources). This is the full set the datadog-operator chart's datadog-crds subchart can
# install; several (datadogagentprofiles, datadogdashboards, datadoggenericresources,
# datadogslos) are disabled by the chart's own defaults and won't exist unless enabled.
kubectl delete crd --ignore-not-found=true \
  datadogagents.datadoghq.com \
  datadogagentprofiles.datadoghq.com \
  datadogagentinternals.datadoghq.com \
  datadoginstrumentations.datadoghq.com \
  datadogmonitors.datadoghq.com \
  datadogslos.datadoghq.com \
  datadogdashboards.datadoghq.com \
  datadogmetrics.datadoghq.com \
  datadogcsidrivers.datadoghq.com \
  datadoggenericresources.datadoghq.com \
  datadogpodautoscalers.datadoghq.com \
  datadogpodautoscalerclusterprofiles.datadoghq.com \
  || echo "WARNING: Could not delete the Datadog Operator CRDs. Continuing..."