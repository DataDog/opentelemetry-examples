#!/usr/bin/env bash
# DEPRECATED: use the install script of the parent folder (../install) with DD_INSTALL_FLOW=ddot instead.
#
# Installs the DDOT components by running the install script of the parent folder (../install) with
# DD_INSTALL_FLOW=ddot. That script does the installation: this one only adds the --local and --config-url options,
# overlay values files given as a URL or as a path relative to the configuration folder, and checks for previous
# setups of this guide.
set -euo pipefail

error() { echo "ERROR: $*" >&2; exit 1; }

# Git tag of DataDog/opentelemetry-examples that ../install and the configuration files are downloaded from by default.
# Keep it equal to INSTALLER_VERSION in ../install.
INSTALLER_VERSION=v0.1.0

# When run through process substitution (`bash <(curl -fsSL .../install)`), the script isn't a
# file on disk: use the current directory (e.g. for --local) instead.
if [[ -f "${BASH_SOURCE[0]}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
else
    SCRIPT_DIR="$PWD"
fi

DEFAULT_CONFIG_URL="https://github.com/DataDog/opentelemetry-examples/tree/$INSTALLER_VERSION/guides/kubernetes/configuration/opentelemetry-kube-stack/ddot"
CONFIG_URL="$DEFAULT_CONFIG_URL"
USE_LOCAL_CONFIG=false

usage() {
    cat <<EOF
Datadog DDOT Install Script $INSTALLER_VERSION

DEPRECATED: use ../install with DD_INSTALL_FLOW=ddot instead. This script runs ../install with DD_INSTALL_FLOW=ddot.

Usage: $0 [--local | --config-url=<url>] [<overlay-values.yaml>]

  --local                 Use ../install and the configuration files of the parent folder of this
                          script ($SCRIPT_DIR/..) instead of downloading them.
  --config-url=<url>      Download ../install and the configuration files from this ddot folder, as
                          a GitHub folder URL (https://github.com/<owner>/<repo>/tree/<branch>/<path>/ddot)
                          or a raw base URL.
                          Default: $DEFAULT_CONFIG_URL
  <overlay-values.yaml>   Optional values file merged on top of values.yaml: a local file, a URL,
                          or a path relative to the ddot configuration folder
                          (e.g. examples/export-to-datadog-and-jaeger/values.yaml).

../install reads its configuration from environment variables, such as DD_API_KEY (required), DD_SITE,
K8S_CLUSTER_TYPE, and K8S_CLUSTER_NAME. See the README.md of the parent folder for the full list.
EOF
}

OVERLAY_VALUES_FILE=""
for arg in "$@"; do
    case "$arg" in
        --local) USE_LOCAL_CONFIG=true ;;
        --config-url=*) CONFIG_URL="${arg#--config-url=}" ;;
        -h|--help) usage; exit 0 ;;
        -*) usage >&2; error "Unknown option: $arg" ;;
        *) OVERLAY_VALUES_FILE="$arg" ;;
    esac
done

echo "WARNING: ddot/install is deprecated. Use the install script of the parent folder with DD_INSTALL_FLOW=ddot:" \
     "https://github.com/DataDog/opentelemetry-examples/tree/main/guides/kubernetes/configuration/opentelemetry-kube-stack/ddot/INSTALL.md" >&2

if [[ -n "${DD_INSTALL_FLOW:-}" && "$DD_INSTALL_FLOW" != ddot ]]; then
    error "DD_INSTALL_FLOW=$DD_INSTALL_FLOW: this script only installs the ddot flow. Run ../install instead."
fi
# Checked here too, so that the checks below don't touch the Kubernetes cluster when ../install would stop anyway.
[[ -n "${DD_API_KEY:-}" ]] || error "DD_API_KEY is not set (see $0 --help)"

DOWNLOAD_DIR="$(mktemp -d)"
trap 'rm -rf "$DOWNLOAD_DIR"' EXIT

# https://github.com/<owner>/<repo>/tree/<branch>/<path> -> https://raw.githubusercontent.com/<owner>/<repo>/<branch>/<path>
# (raw.githubusercontent.com resolves branch names containing "/").
CONFIG_RAW_URL="$(echo "${CONFIG_URL%/}" | sed -E 's|^https://github\.com/([^/]+)/([^/]+)/(tree\|blob)/|https://raw.githubusercontent.com/\1/\2/|')"

if [[ "$USE_LOCAL_CONFIG" == true ]]; then
    PARENT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
    PARENT_INSTALL="$PARENT_DIR/install"
    [[ -f "$PARENT_INSTALL" ]] || error "$PARENT_INSTALL not found: --local needs the parent folder of this script"
    # ../install reads its configuration files from this base URL.
    export TESTING_BASE_URL="file://$PARENT_DIR"
    echo "Using $PARENT_INSTALL and the local configuration files from $PARENT_DIR"
else
    [[ "$CONFIG_RAW_URL" == */ddot ]] || error "--config-url must point to the ddot folder (got '$CONFIG_URL')"
    PARENT_RAW_URL="${CONFIG_RAW_URL%/ddot}"
    PARENT_INSTALL="$DOWNLOAD_DIR/install"
    curl --proto '=https' --tlsv1.2 -fsSL "$PARENT_RAW_URL/install" -o "$PARENT_INSTALL" \
      || error "Could not download $PARENT_RAW_URL/install (use --local to use the files on disk)"
    if [[ "$CONFIG_URL" != "$DEFAULT_CONFIG_URL" ]]; then
        export TESTING_BASE_URL="$PARENT_RAW_URL"
    fi
fi

# ../install only accepts a local overlay values file.
if [[ -n "$OVERLAY_VALUES_FILE" ]]; then
    if [[ "$OVERLAY_VALUES_FILE" =~ ^https?:// || ( "$USE_LOCAL_CONFIG" != true && ! -f "$OVERLAY_VALUES_FILE" ) ]]; then
        # A URL, or a path relative to the remote configuration folder
        OVERLAY_VALUES_URL="$OVERLAY_VALUES_FILE"
        [[ "$OVERLAY_VALUES_URL" =~ ^https?:// ]] || OVERLAY_VALUES_URL="$CONFIG_RAW_URL/${OVERLAY_VALUES_FILE#./}"
        OVERLAY_VALUES_FILE="$DOWNLOAD_DIR/overlay-values.yaml"
        curl -fsSL "$OVERLAY_VALUES_URL" -o "$OVERLAY_VALUES_FILE" \
          || error "Could not download the overlay values file $OVERLAY_VALUES_URL"
    fi
    [[ -f "$OVERLAY_VALUES_FILE" ]] || error "Overlay values file not found: $OVERLAY_VALUES_FILE"
    OVERLAY_VALUES_FILE="$(cd "$(dirname "$OVERLAY_VALUES_FILE")" && pwd)/$(basename "$OVERLAY_VALUES_FILE")"
fi

# Refuse to install next to a previous setup of this guide: two eBPF profilers or two Datadog Agent
# DaemonSets must not run on the same node.
for legacy_release in host-profiler ddagent-kube-stack; do
    if helm status "$legacy_release" --namespace opentelemetry-operator-system >/dev/null 2>&1; then
        error "Found the legacy '$legacy_release' Helm release from a previous setup in the" \
              "opentelemetry-operator-system namespace. Remove it, then re-run this script:" \
              "helm uninstall $legacy_release --namespace opentelemetry-operator-system --wait"
    fi
done

# Earlier versions of this script installed the same releases without recording their options, and ../install refuses
# to install over an OpenTelemetry Operator or a Datadog Operator it didn't install. Record the ddot flow for such an
# installation, so that ../install upgrades it.
INSTALL_OPTIONS_CONFIGMAP=opentelemetry-kube-stack-install-options
if [[ -z "$(kubectl get configmap "$INSTALL_OPTIONS_CONFIGMAP" --namespace opentelemetry-operator-system \
              --ignore-not-found -o name)" ]] \
    && helm status opentelemetry-kube-stack --namespace opentelemetry-operator-system >/dev/null 2>&1 \
    && helm status datadog-operator --namespace datadog >/dev/null 2>&1; then
    echo "Found an installation of an earlier version of this script: recording DD_INSTALL_FLOW=ddot in the" \
         "$INSTALL_OPTIONS_CONFIGMAP ConfigMap so that ../install upgrades it."
    kubectl create configmap "$INSTALL_OPTIONS_CONFIGMAP" \
      --namespace opentelemetry-operator-system \
      --from-literal=DD_INSTALL_FLOW=ddot
fi

export DD_INSTALL_FLOW=ddot
export DD_INSTALL_SOURCE="${DD_INSTALL_SOURCE:-ddot-install}"

# Not exec: the trap removes the downloaded files when ../install exits.
bash "$PARENT_INSTALL" ${OVERLAY_VALUES_FILE:+"$OVERLAY_VALUES_FILE"}
