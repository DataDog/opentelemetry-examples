#!/usr/bin/env bash
set -euo pipefail

error() { echo "ERROR: $*" >&2; exit 1; }

# When run through process substitution (`bash <(curl -fsSL .../install)`), the script isn't a
# file on disk: use the current directory (e.g. for the .env file) instead.
if [[ -f "${BASH_SOURCE[0]}" ]]; then
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
else
    SCRIPT_DIR="$PWD"
fi

# Where the configuration files (values.yaml, datadog-agent.yaml...) are read from: by default
# from GitHub, so that this script can be downloaded and run on its own. Accepts a GitHub folder
# URL (https://github.com/<owner>/<repo>/tree/<branch>/<path>) or a raw base URL.
DEFAULT_CONFIG_URL="https://github.com/DataDog/opentelemetry-examples/tree/cyrille-leclerc/use-dd-operator/guides/kubernetes/configuration/opentelemetry-kube-stack"
CONFIG_URL="$DEFAULT_CONFIG_URL"
USE_LOCAL_CONFIG=false

usage() {
    cat <<EOF
Usage: $0 [--local | --config-url=<url>] [<overlay-values.yaml>]

  --local                 Use the configuration files next to this script ($SCRIPT_DIR)
                          instead of downloading them.
  --config-url=<url>      Download the configuration files from this GitHub folder URL
                          (https://github.com/<owner>/<repo>/tree/<branch>/<path>) or raw base URL.
                          Default: $DEFAULT_CONFIG_URL
  <overlay-values.yaml>   Optional values file merged on top of values.yaml: a local file, a URL,
                          or a path relative to the configuration folder
                          (e.g. examples/export-to-datadog-and-jaeger/values.yaml).
EOF
}

# Optional extra/overlay values.yaml (e.g. examples/export-to-datadog-and-jaeger/values.yaml)
# merged on top of the base values.yaml, and optional flags, in any order.
OVERLAY_VALUES_FILE=""
for arg in "$@"; do
    case "$arg" in
        --local) USE_LOCAL_CONFIG=true ;;
        --config-url=*) CONFIG_URL="${arg#--config-url=}" ;;
        -h|--help) usage; exit 0 ;;
        -*) usage >&2; error "Unknown option: $arg" ;;
        *) OVERLAY_VALUES_FILE="$arg" ;;
    esac
done

# The configuration files used by this script, relative to the configuration folder.
CONFIG_FILES=(
    values.yaml
    datadog-agent.yaml
    host-profiler-rbac-values.yaml
    host-profiler-network-policy.yaml
    host-profiler-cilium-network-policy.yaml
)

# Downloaded files go to a temporary directory, deleted on exit.
DOWNLOAD_DIR="$(mktemp -d)"
trap 'rm -rf "$DOWNLOAD_DIR"' EXIT

# https://github.com/<owner>/<repo>/tree/<branch>/<path> -> https://raw.githubusercontent.com/<owner>/<repo>/<branch>/<path>
# (raw.githubusercontent.com resolves branch names containing "/").
CONFIG_RAW_URL="$(echo "${CONFIG_URL%/}" | sed -E 's|^https://github\.com/([^/]+)/([^/]+)/(tree\|blob)/|https://raw.githubusercontent.com/\1/\2/|')"

if [[ "$USE_LOCAL_CONFIG" == true ]]; then
    CONFIG_DIR="$SCRIPT_DIR"
    echo "Using the local configuration files from $CONFIG_DIR"
else
    CONFIG_DIR="$DOWNLOAD_DIR"
    echo "Downloading the configuration files from $CONFIG_RAW_URL ..."
    for config_file in "${CONFIG_FILES[@]}"; do
        curl -fsSL "$CONFIG_RAW_URL/$config_file" -o "$CONFIG_DIR/$config_file" \
          || error "Could not download $CONFIG_RAW_URL/$config_file (use --local to use the files on disk)"
    done
fi

OVERLAY_VALUES_ARGS=()
if [[ -n "$OVERLAY_VALUES_FILE" ]]; then
    if [[ "$OVERLAY_VALUES_FILE" =~ ^https?:// || ( "$USE_LOCAL_CONFIG" != true && ! -f "$OVERLAY_VALUES_FILE" ) ]]; then
        # A URL, or a path relative to the remote configuration folder
        OVERLAY_VALUES_URL="$OVERLAY_VALUES_FILE"
        [[ "$OVERLAY_VALUES_URL" =~ ^https?:// ]] || OVERLAY_VALUES_URL="$CONFIG_RAW_URL/${OVERLAY_VALUES_FILE#./}"
        OVERLAY_VALUES_FILE="$DOWNLOAD_DIR/overlay-values.yaml"
        curl -fsSL "$OVERLAY_VALUES_URL" -o "$OVERLAY_VALUES_FILE" \
          || error "Could not download the overlay values file $OVERLAY_VALUES_URL"
    fi
    [[ -f "$OVERLAY_VALUES_FILE" ]] || error "Overlay values file not found: $OVERLAY_VALUES_FILE"
    OVERLAY_VALUES_ARGS=(-f "$OVERLAY_VALUES_FILE")
fi

# Refuse to install next to a previous setup of this guide (two eBPF profilers or two Datadog Agent
# DaemonSets must not run on the same node): the `migrate` script removes it.
for legacy_release in host-profiler ddagent-kube-stack; do
    if helm status "$legacy_release" --namespace opentelemetry-operator-system >/dev/null 2>&1; then
        error "Found the legacy '$legacy_release' Helm release from a previous setup in the" \
              "opentelemetry-operator-system namespace: run ./migrate to remove it, then re-run this script."
    fi
done

# Load the Datadog credentials from the .env file if it exists, prompt for them otherwise
if [[ -f "$SCRIPT_DIR/.env" ]]; then
    source "$SCRIPT_DIR/.env"
else
    echo ".env file not found in folder $SCRIPT_DIR . Entering interactive setup..."

    read -p "Datadog Site (eg: 'datadoghq.eu'): " DD_SITE
    [[ -z "$DD_SITE" ]] && error "Datadog Site cannot be empty"

    read -r -s -p "Datadog API Key (eg: '1234...'): " DD_API_KEY
    echo
    [[ -z "$DD_API_KEY" ]] && error "Datadog API Key cannot be empty"

    # Optional but strongly recommended: the Datadog Operator needs an application key to manage the Datadog Agent
    # from Datadog Fleet Automation (see the Datadog Operator installation below).
    read -r -s -p "Datadog Application Key, optional but strongly recommended, to manage the Agent from Fleet Automation (leave empty to skip): " DD_APP_KEY
    echo
fi

# Verify all required credentials are set
[[ -z "${DD_API_KEY:-}" ]] && error "DD_API_KEY is not set"

echo ""
echo "Collecting deployment configuration..."
echo ""

echo "Kubernetes Cluster Type:"
PS3="Select the Kubernetes cluster type (enter a number): "
select KUBE_CLUSTER_TYPE in "Amazon Elastic Kubernetes Service (EKS)" "Google Kubernetes Engine (GKE)" "Azure Kubernetes Service (AKS)" "Other"; do
    [[ -n "$KUBE_CLUSTER_TYPE" ]] && break
    echo "Invalid selection, please try again."
done

case "$KUBE_CLUSTER_TYPE" in
    "Amazon Elastic Kubernetes Service (EKS)") K8S_MANAGED_SERVICE_DETECTOR="eks" ;;
    "Google Kubernetes Engine (GKE)") K8S_MANAGED_SERVICE_DETECTOR="gcp" ;;
    "Azure Kubernetes Service (AKS)") K8S_MANAGED_SERVICE_DETECTOR="aks" ;;
    *) K8S_MANAGED_SERVICE_DETECTOR="" ;;
esac
export K8S_MANAGED_SERVICE_DETECTOR


# The Datadog Agent only accepts lowercase letters, digits, "-" and "." in cluster names (no
# uppercase, no "_"): it rewrites "_" to "-" and ignores names with uppercase letters.
#
# On EKS/GKE/AKS, the cluster name is auto-detected (k8s.cluster.name by the OpenTelemetry Collector
# Resource Detection Processor, clusterName by the Datadog Agent), except for the Datadog Operator:
# its Remote Configuration, used by Fleet Automation, only reads the clusterName Helm value. So with
# an application key, also prompt for the cluster name on EKS/GKE/AKS, defaulting to the name in the
# current kubectl context, and use it everywhere so all the telemetry has the same cluster name.
K8S_CLUSTER_NAME=""
if [[ "$KUBE_CLUSTER_TYPE" == "Other" ]]; then
    read -p "Kubernetes Cluster Name (default: 'unknown-k8s-cluster'): " K8S_CLUSTER_NAME
    K8S_CLUSTER_NAME=${K8S_CLUSTER_NAME:-unknown-k8s-cluster}
elif [[ -n "${DD_APP_KEY:-}" ]]; then
    KUBE_CONTEXT=$(kubectl config current-context 2>/dev/null || true)
    case "$K8S_MANAGED_SERVICE_DETECTOR" in
        # "arn:aws:eks:<region>:<account>:cluster/<name>" or eksctl's "<user>@<name>.<region>.eksctl.io"
        eks) case "$KUBE_CONTEXT" in
                 arn:aws:eks:*) DEFAULT_K8S_CLUSTER_NAME="${KUBE_CONTEXT##*/}" ;;
                 *@*.eksctl.io) DEFAULT_K8S_CLUSTER_NAME="${KUBE_CONTEXT#*@}"; DEFAULT_K8S_CLUSTER_NAME="${DEFAULT_K8S_CLUSTER_NAME%%.*}" ;;
                 *) DEFAULT_K8S_CLUSTER_NAME="" ;;
             esac ;;
        # "gke_<project>_<location>_<name>", GKE cluster names have no "_"
        gcp) [[ "$KUBE_CONTEXT" == gke_* ]] && DEFAULT_K8S_CLUSTER_NAME="${KUBE_CONTEXT##*_}" || DEFAULT_K8S_CLUSTER_NAME="" ;;
        # `az aks get-credentials` names the context after the cluster
        *) DEFAULT_K8S_CLUSTER_NAME="$KUBE_CONTEXT" ;;
    esac
    echo "Fleet Automation needs the Kubernetes cluster name for the Datadog Operator."
    if [[ -n "$DEFAULT_K8S_CLUSTER_NAME" ]]; then
        read -p "Kubernetes Cluster Name (default: '$DEFAULT_K8S_CLUSTER_NAME'): " K8S_CLUSTER_NAME
        K8S_CLUSTER_NAME=${K8S_CLUSTER_NAME:-$DEFAULT_K8S_CLUSTER_NAME}
    else
        read -p "Kubernetes Cluster Name (leave empty to auto-detect it, without Fleet Automation): " K8S_CLUSTER_NAME
    fi
fi
if [[ -n "$K8S_CLUSTER_NAME" ]]; then
    NORMALIZED_K8S_CLUSTER_NAME=$(echo "$K8S_CLUSTER_NAME" | tr '[:upper:]_' '[:lower:]-')
    if [[ "$NORMALIZED_K8S_CLUSTER_NAME" != "$K8S_CLUSTER_NAME" ]]; then
        echo "Using cluster name '$NORMALIZED_K8S_CLUSTER_NAME' instead of '$K8S_CLUSTER_NAME' (lowercase, '-' instead of '_')."
        K8S_CLUSTER_NAME="$NORMALIZED_K8S_CLUSTER_NAME"
    fi
fi
export K8S_CLUSTER_NAME

read -p "Deployment Environment Name like 'production', 'staging'... (default: 'production'): " DEPLOYMENT_ENVIRONMENT_NAME
export DEPLOYMENT_ENVIRONMENT_NAME=${DEPLOYMENT_ENVIRONMENT_NAME:-production}

# The eBPF host profiler needs Linux nodes with kernel >= 5.10 and runs one
# collector per node with eBPF capabilities. Off by default: it is a security
# decision, not a configuration detail.
read -p "Enable the eBPF host profiler? (requires Linux nodes, kernel >= 5.10) (y/N): " ENABLE_HOST_PROFILER
export ENABLE_HOST_PROFILER=${ENABLE_HOST_PROFILER:-N}
HOST_PROFILER_NETWORK_POLICY_FILE=""

if [[ "$ENABLE_HOST_PROFILER" == "y" || "$ENABLE_HOST_PROFILER" == "Y" ]]; then
    # Egress policy for the profiler, only useful on default-deny clusters
    # whose CNI enforces NetworkPolicy.
    read -p "Egress NetworkPolicy? (n)one / (s)tandard / (c)ilium (default: none): " HOST_PROFILER_NETWORK_POLICY
    case "${HOST_PROFILER_NETWORK_POLICY:-n}" in
        s*) HOST_PROFILER_NETWORK_POLICY_FILE="$CONFIG_DIR/host-profiler-network-policy.yaml" ;;
        c*) HOST_PROFILER_NETWORK_POLICY_FILE="$CONFIG_DIR/host-profiler-cilium-network-policy.yaml" ;;
    esac
    HOST_PROFILER_ENABLED_ARGS=(
        --set collectors.host-profiler.enabled=true
        -f "$CONFIG_DIR/host-profiler-rbac-values.yaml"
    )
fi
echo ""

#### BEGINNING OF INSTALLATION SCRIPT

# WARNING: dont change "namespace=opentelemetry-operator-system" as it is used in the 'instrumentation' CRD defined in values.yaml

echo "Creating Kubernetes namespaces..."

kubectl create namespace opentelemetry-operator-system || echo "WARNING: Could not create namespace 'opentelemetry-operator-system' (may already exist or insufficient permissions). Continuing..."
# The Datadog Operator and the DatadogAgent custom resource live in their own
# "datadog" namespace, separate from the OpenTelemetry Kube Stack.
kubectl create namespace datadog || echo "WARNING: Could not create namespace 'datadog' (may already exist or insufficient permissions). Continuing..."

echo "Creating or updating Datadog secret..."

# The secret is duplicated in both namespaces: opentelemetry-operator-system's
# copy is used by the Datadog exporter in the OTel collectors (see values.yaml),
# and datadog's copy is used by the DatadogAgent custom resource and the Datadog
# Operator. Only datadog's copy holds the (optional) application key.
for DD_SECRET_NAMESPACE in opentelemetry-operator-system datadog; do
    DD_APP_KEY_SECRET_ARGS=()
    if [[ "$DD_SECRET_NAMESPACE" == "datadog" && -n "${DD_APP_KEY:-}" ]]; then
        DD_APP_KEY_SECRET_ARGS=(--from-literal="app-key=$DD_APP_KEY")
    fi
    kubectl create secret generic datadog-secret \
      --namespace "$DD_SECRET_NAMESPACE"  \
      --from-literal="api-key=$DD_API_KEY" \
      --from-literal="dd-site=${DD_SITE:-datadoghq.com}" \
      ${DD_APP_KEY_SECRET_ARGS[@]+"${DD_APP_KEY_SECRET_ARGS[@]}"} \
      --dry-run=client -o yaml | kubectl apply -f -
done

echo "Configuring and updating Helm"

helm repo add open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts
helm repo add jetstack       https://charts.jetstack.io
helm repo add datadog        https://helm.datadoghq.com
helm repo update

# Detect cert-manager by its CRD rather than by a Helm release, to also skip installations done
# without Helm, under another release name, or by a managed Kubernetes add-on.
if kubectl get crd certificates.cert-manager.io >/dev/null 2>&1; then
    echo "cert-manager is already installed (certificates.cert-manager.io CRD found), skipping its installation."
else
    echo "Installing cert-manager..."
    helm install cert-manager jetstack/cert-manager \
      --namespace cert-manager --create-namespace \
      --set crds.enabled=true  \
      --wait --timeout 5m \
      || echo "WARNING: Could not install cert-manager (insufficient permissions?). Continuing..."
fi

echo "Installing OpenTelemetry Kube Stack Helm Chart..."

# FIXME use deployment.environment.name, it's a workaround for https://github.com/DataDog/dd-trace-java/pull/12324
HELM_SET_ARGS=(
    --set-string "resourceAttributes.deployment\.environment=$DEPLOYMENT_ENVIRONMENT_NAME"
    --set-string "resourceAttributes.deployment\.environment\.name=$DEPLOYMENT_ENVIRONMENT_NAME"
)

# The eks, aks and gcp presets are disabled by default in the chart: enable the cluster's one.
if [[ -n "$K8S_MANAGED_SERVICE_DETECTOR" ]]; then
    HELM_SET_ARGS+=(--set "defaultCRConfig.presets.resourceDetection.${K8S_MANAGED_SERVICE_DETECTOR}.enabled=true")
fi

if [[ -n "$K8S_CLUSTER_NAME" ]]; then
    HELM_SET_ARGS+=(--set-string "resourceAttributes.k8s\.cluster\.name=$K8S_CLUSTER_NAME")
fi

helm upgrade opentelemetry-kube-stack \
    open-telemetry/opentelemetry-kube-stack \
    --version 0.24.2 \
    --install \
    --namespace opentelemetry-operator-system \
    "${HELM_SET_ARGS[@]}" \
    -f "$CONFIG_DIR/values.yaml" \
    ${HOST_PROFILER_ENABLED_ARGS[@]+"${HOST_PROFILER_ENABLED_ARGS[@]}"} \
    ${OVERLAY_VALUES_ARGS[@]+"${OVERLAY_VALUES_ARGS[@]}"}

# The standard and Cilium policies select the same pods and Kubernetes
# NetworkPolicies are additive: remove both NetworkPolicy before applying
# the selected one (or none), so a policy from a previous run cannot widen
# the requested egress.
kubectl delete networkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  opentelemetry-kube-stack-host-profiler-egress \
  || echo "WARNING: Could not delete the host-profiler NetworkPolicy. Continuing..."
kubectl delete ciliumnetworkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  opentelemetry-kube-stack-host-profiler-egress \
  || echo "WARNING: CiliumNetworkPolicy CRD not installed. Continuing..."

if [[ -n "$HOST_PROFILER_NETWORK_POLICY_FILE" ]]; then
    echo "Applying the host-profiler egress NetworkPolicy..."
    kubectl apply -f "$HOST_PROFILER_NETWORK_POLICY_FILE" \
      || echo "WARNING: Could not apply the host-profiler egress NetworkPolicy (is Cilium installed if you chose the Cilium policy?). Continuing..."
fi

echo "Installing Datadog Operator..."

# The Operator's own identity (API key, site and cluster name), used for its telemetry and
# metadata. Without them, the Operator falls back to the DatadogAgent's credentials and settings.
OPERATOR_HELM_ARGS=(
    --set apiKeyExistingSecret=datadog-secret
    --set-string site="${DD_SITE:-datadoghq.com}"
)
if [[ -n "$K8S_CLUSTER_NAME" ]]; then
    OPERATOR_HELM_ARGS+=(--set-string clusterName="$K8S_CLUSTER_NAME")
fi

# Fleet Automation: with an application key, the Operator connects to Datadog Remote
# Configuration so the Datadog Agent can be managed from Datadog:
# - remoteConfiguration.enabled: enable/disable Agent features (e.g. from the Datadog UI),
# - previewFleetRollouts: apply Fleet Automation configuration changes to the DatadogAgent
#   (Preview, request access for your org at
#   https://www.datadoghq.com/product-preview/configure-agent-kubernetes-operator/).
if [[ -n "${DD_APP_KEY:-}" ]]; then
    echo "Enabling Fleet Automation (Remote Configuration) in the Datadog Operator..."
    OPERATOR_HELM_ARGS+=(
        --set appKeyExistingSecret=datadog-secret
        --set remoteConfiguration.enabled=true
        --set previewFleetRollouts=true
    )
    if [[ -z "$K8S_CLUSTER_NAME" ]]; then
        echo "WARNING: No cluster name set: the Datadog Operator's Remote Configuration requires one." \
             "Re-run this script and enter the cluster name to enable Fleet Automation."
    fi
else
    echo "DD_APP_KEY not set: Fleet Automation (managing the Agent from Datadog) is disabled." \
         "Add 'export DD_APP_KEY=...' to $SCRIPT_DIR/.env and re-run this script to enable it."
fi

helm upgrade datadog-operator \
    datadog/datadog-operator \
    --install \
    --namespace datadog \
    ${OPERATOR_HELM_ARGS[@]+"${OPERATOR_HELM_ARGS[@]}"} \
    --wait --timeout 5m

echo "Applying the DatadogAgent custom resource..."

# Without a cluster name (EKS/GKE/AKS without an application key), drop the `clusterName` line so
# the Datadog Agent auto-detects the cluster name from the cloud provider. An empty `clusterName: ""`
# isn't enough, the Operator would still set DD_CLUSTER_NAME on the agent containers.
# Only set the Agent hostname from the Kubernetes node name and the cluster name on non-cloud
# clusters: on EKS/GKE/AKS, the cloud provider hostname is preferred.
if [[ -n "$K8S_CLUSTER_NAME" ]]; then
    CLUSTER_NAME_SED_ARGS=(-e "s|<CLUSTER_NAME>|$K8S_CLUSTER_NAME|")
else
    CLUSTER_NAME_SED_ARGS=(-e "/<CLUSTER_NAME>/d")
fi
if [[ "$KUBE_CLUSTER_TYPE" == "Other" ]]; then
    CLUSTER_NAME_SED_ARGS+=(-e "/<HOSTNAME_FROM_NODE_NAME:/d")
else
    CLUSTER_NAME_SED_ARGS+=(-e "/<HOSTNAME_FROM_NODE_NAME:BEGIN>/,/<HOSTNAME_FROM_NODE_NAME:END>/d")
fi

sed \
  "${CLUSTER_NAME_SED_ARGS[@]}" \
  -e "s|<DD_SITE>|${DD_SITE:-datadoghq.com}|" \
  "$CONFIG_DIR/datadog-agent.yaml" \
  | kubectl apply --namespace datadog -f -
