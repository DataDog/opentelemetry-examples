#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

require_bool() {
    case "${!1}" in
        true|false) ;;
        *)
            echo "ERROR: $1 must be one of: true, false (got '${!1}')" >&2
            exit 1
            ;;
    esac
}

# Optional extra/overlay values.yaml merged on top of the base values file.
OVERLAY_VALUES_FILE="${1:-}"
OVERLAY_VALUES_ARGS=()
if [[ -n "$OVERLAY_VALUES_FILE" ]]; then
    [[ -f "$OVERLAY_VALUES_FILE" ]] || { echo "Overlay values file not found: $OVERLAY_VALUES_FILE" >&2; exit 1; }
    OVERLAY_VALUES_ARGS=(-f "$OVERLAY_VALUES_FILE")
fi

if [[ -z "${DD_API_KEY:-}" ]]; then
    echo "ERROR: DD_API_KEY is not set" >&2
    exit 1
fi

case "${DD_INSTALL_FLOW:-}" in
    upstream) VALUES_FILE=values-otlp-http.yaml ;;
    ddot) VALUES_FILE=values-ddot.yaml ;;
    *)
        echo "ERROR: DD_INSTALL_FLOW must be one of: upstream, ddot (got '${DD_INSTALL_FLOW:-}')" >&2
        exit 1
        ;;
esac

DD_SITE=${DD_SITE:-datadoghq.com}
K8S_CLUSTER_TYPE=${K8S_CLUSTER_TYPE:-other}
DEPLOYMENT_ENVIRONMENT_NAME=${DEPLOYMENT_ENVIRONMENT_NAME:-production}
DD_AGENT_ENABLED=${DD_AGENT_ENABLED:-true}
require_bool DD_AGENT_ENABLED

DD_AGENT_VALUES_ARGS=()
if [[ "$DD_INSTALL_FLOW" == "ddot" && "$DD_AGENT_ENABLED" == "true" ]]; then
    DD_AGENT_VALUES_ARGS=(-f "$SCRIPT_DIR/dd-agent-kube-stack-values.yaml")
fi

case "$K8S_CLUSTER_TYPE" in
    eks|gcp|aks|other) ;;
    *)
        echo "ERROR: K8S_CLUSTER_TYPE must be one of: eks, gcp, aks, other (got '$K8S_CLUSTER_TYPE')" >&2
        exit 1
        ;;
esac

# The eBPF host profiler needs Linux nodes with kernel >= 5.10 and runs one
# collector per node with eBPF capabilities. Off by default because of these
# extra privileges.
DD_HOST_PROFILER_ENABLED=${DD_HOST_PROFILER_ENABLED:-false}
DD_HOST_PROFILER_NETWORK_POLICY=${DD_HOST_PROFILER_NETWORK_POLICY:-none}
HOST_PROFILER_NETWORK_POLICY_FILE=""
HOST_PROFILER_ENABLED_ARGS=()

require_bool DD_HOST_PROFILER_ENABLED

if [[ "$DD_HOST_PROFILER_ENABLED" == "true" ]]; then
    # Egress policy for the profiler, only useful on default-deny clusters
    # whose CNI enforces NetworkPolicy.
    case "$DD_HOST_PROFILER_NETWORK_POLICY" in
        none) ;;
        standard) HOST_PROFILER_NETWORK_POLICY_FILE="$SCRIPT_DIR/host-profiler-network-policy.yaml" ;;
        cilium) HOST_PROFILER_NETWORK_POLICY_FILE="$SCRIPT_DIR/host-profiler-cilium-network-policy.yaml" ;;
        *)
            echo "ERROR: DD_HOST_PROFILER_NETWORK_POLICY must be one of: none, standard, cilium (got '$DD_HOST_PROFILER_NETWORK_POLICY')" >&2
            exit 1
            ;;
    esac
    HOST_PROFILER_ENABLED_ARGS=(
        --set collectors.host-profiler.enabled=true
        -f "$SCRIPT_DIR/host-profiler-rbac-values.yaml"
    )
fi

#### BEGINNING OF INSTALLATION SCRIPT

# WARNING: dont change "namespace=opentelemetry-operator-system" as it is used in the 'instrumentation' CRD defined in values-otlp-http.yaml and values-ddot.yaml

echo "Creating Kubernetes namespace..."

kubectl create namespace opentelemetry-operator-system || echo "WARNING: Could not create namespace 'opentelemetry-operator-system' (may already exist or insufficient permissions). Continuing..."

echo "Creating or updating Datadog secret..."

kubectl create secret generic datadog-secret \
  --namespace opentelemetry-operator-system  \
  --from-literal="api-key=$DD_API_KEY" \
  --from-literal="dd-site=$DD_SITE" \
  --dry-run=client -o yaml | kubectl apply -f -

echo "Installing cert-manager (if not already installed)..."

helm repo add jetstack https://charts.jetstack.io
helm repo update
helm install cert-manager jetstack/cert-manager \
  --namespace cert-manager --create-namespace \
  --set crds.enabled=true  \
  --wait --timeout 5m \
  || echo "WARNING: Could not install cert-manager (may already exist or insufficient permissions). Continuing..."

echo "Installing OpenTelemetry Kube Stack Helm Chart..."

helm repo add open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts
helm repo update

HELM_SET_ARGS=(
    --set-string "resourceAttributes.deployment\.environment\.name=$DEPLOYMENT_ENVIRONMENT_NAME"
)

if [[ "$K8S_CLUSTER_TYPE" != "other" ]]; then
    HELM_SET_ARGS+=(--set "defaultCRConfig.presets.resourceDetection.$K8S_CLUSTER_TYPE.enabled=true")
fi

if [[ "$K8S_CLUSTER_TYPE" == "eks" ]]; then
    HELM_SET_ARGS+=(--set "defaultCRConfig.config.processors.resource_detection/env.eks.node_from_env_var=K8S_NODE_NAME")
fi

if [[ -n "${K8S_CLUSTER_NAME:-}" ]]; then
    HELM_SET_ARGS+=(--set-string "resourceAttributes.k8s\.cluster\.name=$K8S_CLUSTER_NAME")
fi

helm upgrade opentelemetry-kube-stack \
    open-telemetry/opentelemetry-kube-stack \
    --version 0.23.0 \
    --install \
    --namespace opentelemetry-operator-system \
    "${HELM_SET_ARGS[@]}" \
    -f "$SCRIPT_DIR/$VALUES_FILE" \
    ${DD_AGENT_VALUES_ARGS[@]+"${DD_AGENT_VALUES_ARGS[@]}"} \
    ${HOST_PROFILER_ENABLED_ARGS[@]+"${HOST_PROFILER_ENABLED_ARGS[@]}"} \
    ${OVERLAY_VALUES_ARGS[@]+"${OVERLAY_VALUES_ARGS[@]}"}

# The standard and Cilium policies select the same pods and Kubernetes
# NetworkPolicies are additive: remove both NetworkPolicy before applying
# the selected one (or none), so a policy from a previous run cannot widen
# the requested egress.
kubectl delete networkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  opentelemetry-kube-stack-host-profiler-egress \
  || echo "WARNING: Could not delete the host-profiler NetworkPolicy. Continuing..."
kubectl delete ciliumnetworkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  opentelemetry-kube-stack-host-profiler-egress \
  || echo "WARNING: CiliumNetworkPolicy CRD not installed. Continuing..."

if [[ -n "$HOST_PROFILER_NETWORK_POLICY_FILE" ]]; then
    echo "Applying the host-profiler egress NetworkPolicy..."
    kubectl apply -f "$HOST_PROFILER_NETWORK_POLICY_FILE" \
      || echo "WARNING: Could not apply the host-profiler egress NetworkPolicy (is Cilium installed if you chose the Cilium policy?). Continuing..."
fi

if [[ "$DD_INSTALL_FLOW" == "ddot" && "$DD_AGENT_ENABLED" == "true" ]]; then
    echo "Installing Datadog Agent"

    helm repo add datadog https://helm.datadoghq.com
    helm repo update

    helm upgrade ddagent-kube-stack \
        datadog/datadog \
        --version 3.240.0 \
        --install \
        --namespace opentelemetry-operator-system \
        --set-string datadog.clusterName=${K8S_CLUSTER_NAME:-} \
        --set-string datadog.apiKeyExistingSecret='datadog-secret' \
        --set-string datadog.site=$DD_SITE \
        "${HELM_SET_ARGS[@]}" \
        -f "$SCRIPT_DIR/dd-agent-values.yaml"
fi
