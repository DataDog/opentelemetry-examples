#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

require_bool() {
    case "${!1}" in
        true|false) ;;
        *)
            echo "ERROR: $1 must be one of: true, false (got '${!1}')" >&2
            exit 1
            ;;
    esac
}

# Optional extra/overlay values.yaml merged on top of the base values file.
OVERLAY_VALUES_FILE="${1:-}"
OVERLAY_VALUES_ARGS=()
if [[ -n "$OVERLAY_VALUES_FILE" ]]; then
    [[ -f "$OVERLAY_VALUES_FILE" ]] || { echo "Overlay values file not found: $OVERLAY_VALUES_FILE" >&2; exit 1; }
    OVERLAY_VALUES_ARGS=(-f "$OVERLAY_VALUES_FILE")
fi

if [[ -z "${DD_API_KEY:-}" ]]; then
    echo "ERROR: DD_API_KEY is not set" >&2
    exit 1
fi

for tool in kubectl helm; do
    command -v "$tool" >/dev/null || { echo "ERROR: $tool is not installed" >&2; exit 1; }
done

KUBE_CONTEXT=$(command kubectl config current-context) || {
    echo "ERROR: No current kubectl context is set" >&2
    exit 1
}
kubectl() { command kubectl --context "$KUBE_CONTEXT" "$@"; }
helm() { command helm --kube-context "$KUBE_CONTEXT" "$@"; }
echo "Installing into the kubectl context '$KUBE_CONTEXT' ($(kubectl config view --minify -o jsonpath='{.clusters[0].cluster.server}'))"

case "${DD_INSTALL_FLOW:-}" in
    upstream) VALUES_FILE=values-otlp-http.yaml ;;
    ddot) VALUES_FILE=values-ddot.yaml ;;
    *)
        echo "ERROR: DD_INSTALL_FLOW must be one of: upstream, ddot (got '${DD_INSTALL_FLOW:-}')" >&2
        exit 1
        ;;
esac

DD_SITE=${DD_SITE:-datadoghq.com}
K8S_CLUSTER_TYPE=${K8S_CLUSTER_TYPE:-other}
DEPLOYMENT_ENVIRONMENT_NAME=${DEPLOYMENT_ENVIRONMENT_NAME:-production}
DD_AGENT_ENABLED=${DD_AGENT_ENABLED:-true}
require_bool DD_AGENT_ENABLED

DD_AGENT_VALUES_ARGS=()
if [[ "$DD_INSTALL_FLOW" == "ddot" && "$DD_AGENT_ENABLED" == "true" ]]; then
    DD_AGENT_VALUES_ARGS=(-f "$SCRIPT_DIR/dd-agent-kube-stack-values.yaml")

    if [[ -n "${DD_APP_KEY:-}" && -z "${K8S_CLUSTER_NAME:-}" ]]; then
        echo "ERROR: K8S_CLUSTER_NAME must be set when DD_APP_KEY is set (Fleet Automation requires a cluster name)" >&2
        exit 1
    fi
fi

case "$K8S_CLUSTER_TYPE" in
    eks|gcp|aks|other) ;;
    *)
        echo "ERROR: K8S_CLUSTER_TYPE must be one of: eks, gcp, aks, other (got '$K8S_CLUSTER_TYPE')" >&2
        exit 1
        ;;
esac

# The eBPF host profiler needs Linux nodes with kernel >= 5.10 and runs one
# collector per node with eBPF capabilities. Off by default because of these
# extra privileges.
DD_HOST_PROFILER_ENABLED=${DD_HOST_PROFILER_ENABLED:-false}
DD_HOST_PROFILER_NETWORK_POLICY=${DD_HOST_PROFILER_NETWORK_POLICY:-none}
HOST_PROFILER_NETWORK_POLICY_FILE=""
HOST_PROFILER_ENABLED_ARGS=()

require_bool DD_HOST_PROFILER_ENABLED

if [[ "$DD_HOST_PROFILER_ENABLED" == "true" ]]; then
    # Egress policy for the profiler, only useful on default-deny clusters
    # whose CNI enforces NetworkPolicy.
    case "$DD_HOST_PROFILER_NETWORK_POLICY" in
        none) ;;
        standard) HOST_PROFILER_NETWORK_POLICY_FILE="$SCRIPT_DIR/ddot/host-profiler-network-policy.yaml" ;;
        cilium) HOST_PROFILER_NETWORK_POLICY_FILE="$SCRIPT_DIR/ddot/host-profiler-cilium-network-policy.yaml" ;;
        *)
            echo "ERROR: DD_HOST_PROFILER_NETWORK_POLICY must be one of: none, standard, cilium (got '$DD_HOST_PROFILER_NETWORK_POLICY')" >&2
            exit 1
            ;;
    esac
    HOST_PROFILER_ENABLED_ARGS=(
        --set collectors.host-profiler.enabled=true
        -f "$SCRIPT_DIR/ddot/host-profiler-rbac-values.yaml"
    )
fi

if [[ "$DD_HOST_PROFILER_ENABLED" == "true" && "$DD_HOST_PROFILER_NETWORK_POLICY" == "cilium" ]] && ! kubectl get crd ciliumnetworkpolicies.cilium.io >/dev/null 2>&1; then
    echo "ERROR: DD_HOST_PROFILER_NETWORK_POLICY=cilium requires Cilium (the ciliumnetworkpolicies.cilium.io CRD was not found)" >&2
    exit 1
fi

#### BEGINNING OF INSTALLATION SCRIPT

trap 'if (( $? != 0 )); then echo "ERROR: The installation did not finish. Fix the error above, run ./uninstall, and run this script again." >&2; fi' EXIT

# WARNING: dont change "namespace=opentelemetry-operator-system" as it is used in the 'instrumentation' CRD defined in values-otlp-http.yaml and values-ddot.yaml

echo "Creating Kubernetes namespace..."

kubectl create namespace opentelemetry-operator-system || echo "WARNING: Could not create namespace 'opentelemetry-operator-system' (may already exist or insufficient permissions). Continuing..."

echo "Creating or updating Datadog secret..."

kubectl create secret generic datadog-secret \
  --namespace opentelemetry-operator-system  \
  --from-file=api-key=<(printf '%s' "$DD_API_KEY") \
  --from-literal="dd-site=$DD_SITE" \
  --dry-run=client -o yaml | kubectl apply -f -

echo "Installing cert-manager (if not already installed)..."

helm install cert-manager cert-manager \
  --repo https://charts.jetstack.io \
  --version v1.21.3 \
  --namespace cert-manager --create-namespace \
  --set crds.enabled=true  \
  --wait --timeout 5m \
  || echo "WARNING: Could not install cert-manager (may already exist or insufficient permissions). Continuing..."

if [[ -n "$HOST_PROFILER_NETWORK_POLICY_FILE" ]]; then
    echo "Applying the host-profiler egress NetworkPolicy..."
    kubectl apply -f "$HOST_PROFILER_NETWORK_POLICY_FILE"
fi

if [[ "$DD_INSTALL_FLOW" == "ddot" && "$DD_AGENT_ENABLED" == "true" ]]; then
    echo "Installing Datadog Operator..."

    kubectl create namespace datadog || echo "WARNING: Could not create namespace 'datadog' (may already exist or insufficient permissions). Continuing..."

    kubectl create secret generic datadog-secret \
      --namespace datadog \
      --from-env-file=<(
          printf 'api-key=%s\n' "$DD_API_KEY"
          if [[ -n "${DD_APP_KEY:-}" ]]; then
              printf 'app-key=%s\n' "$DD_APP_KEY"
          fi
      ) \
      --dry-run=client -o yaml | kubectl apply -f -

    OPERATOR_HELM_ARGS=(
        --set apiKeyExistingSecret=datadog-secret
        --set-string site="$DD_SITE"
    )
    if [[ -n "${K8S_CLUSTER_NAME:-}" ]]; then
        OPERATOR_HELM_ARGS+=(--set-string clusterName="$K8S_CLUSTER_NAME")
    fi

    if [[ -n "${DD_APP_KEY:-}" ]]; then
        echo "Enabling Fleet Automation in the Datadog Operator..."
        OPERATOR_HELM_ARGS+=(
            --set appKeyExistingSecret=datadog-secret
            --set remoteConfiguration.enabled=true
            --set previewFleetRollouts=true
        )
    fi

    helm upgrade datadog-operator \
        datadog-operator \
        --repo https://helm.datadoghq.com \
        --version 2.28.1 \
        --install \
        --namespace datadog \
        "${OPERATOR_HELM_ARGS[@]}" \
        --wait --timeout 5m

    echo "Applying the DatadogAgent custom resource..."

    GLOBAL_JSON="\"site\":\"$DD_SITE\",\"tags\":[\"env:$DEPLOYMENT_ENVIRONMENT_NAME\"]"
    if [[ -n "${K8S_CLUSTER_NAME:-}" ]]; then
        GLOBAL_JSON+=",\"clusterName\":\"$K8S_CLUSTER_NAME\""
    fi
    kubectl patch --local \
      -f "$SCRIPT_DIR/datadog-agent.yaml" \
      --type merge \
      -p "{\"spec\":{\"global\":{$GLOBAL_JSON}}}" \
      -o yaml | kubectl apply --namespace datadog -f -
fi

# Installed last so the Helm release notes are the last output the user sees.
echo "Installing OpenTelemetry Kube Stack Helm Chart..."

HELM_SET_ARGS=(
    --set-string "resourceAttributes.deployment\.environment\.name=$DEPLOYMENT_ENVIRONMENT_NAME"
)

if [[ "$K8S_CLUSTER_TYPE" != "other" ]]; then
    HELM_SET_ARGS+=(--set "defaultCRConfig.presets.resourceDetection.$K8S_CLUSTER_TYPE.enabled=true")
fi

if [[ "$K8S_CLUSTER_TYPE" == "eks" ]]; then
    HELM_SET_ARGS+=(--set "defaultCRConfig.config.processors.resource_detection/env.eks.node_from_env_var=K8S_NODE_NAME")
    HELM_SET_ARGS+=(--set "defaultCRConfig.config.processors.resource_detection/env.eks.resource_attributes.host\.id.enabled=true")
    HELM_SET_ARGS+=(--set "defaultCRConfig.config.processors.resource_detection/env.eks.resource_attributes.cloud\.region.enabled=true")
    HELM_SET_ARGS+=(--set "defaultCRConfig.config.processors.resource_detection/env.eks.resource_attributes.cloud\.availability_zone.enabled=true")
    HELM_SET_ARGS+=(--set "defaultCRConfig.config.processors.resource_detection/env.eks.resource_attributes.cloud\.account\.id.enabled=true")
    HELM_SET_ARGS+=(--set "defaultCRConfig.config.processors.resource_detection/env.eks.resource_attributes.host\.image\.id.enabled=true")
    HELM_SET_ARGS+=(--set "defaultCRConfig.config.processors.resource_detection/env.eks.resource_attributes.host\.type.enabled=true")
    HELM_SET_ARGS+=(--set "collectors.daemon.config.processors.resource_detection/env.override=true")
    HELM_SET_ARGS+=(--set "collectors.daemon.config.processors.resource_detection/env.eks.resource_attributes.host\.name.enabled=true")
fi

if [[ -n "${K8S_CLUSTER_NAME:-}" ]]; then
    HELM_SET_ARGS+=(--set-string "resourceAttributes.k8s\.cluster\.name=$K8S_CLUSTER_NAME")
fi

helm upgrade opentelemetry-kube-stack \
    opentelemetry-kube-stack \
    --repo https://open-telemetry.github.io/opentelemetry-helm-charts \
    --version 0.26.1 \
    --install \
    --namespace opentelemetry-operator-system \
    --wait --timeout 5m \
    "${HELM_SET_ARGS[@]}" \
    -f "$SCRIPT_DIR/$VALUES_FILE" \
    ${DD_AGENT_VALUES_ARGS[@]+"${DD_AGENT_VALUES_ARGS[@]}"} \
    ${HOST_PROFILER_ENABLED_ARGS[@]+"${HOST_PROFILER_ENABLED_ARGS[@]}"} \
    ${OVERLAY_VALUES_ARGS[@]+"${OVERLAY_VALUES_ARGS[@]}"}
