#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Optional extra/overlay values.yaml (e.g. examples/export-to-datadog-and-jaeger/values.yaml)
# merged on top of the base values.yaml, and an optional "--force-conflicts" flag, in any order.
OVERLAY_VALUES_FILE=""
FORCE_CONFLICTS_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--force-conflicts" ]]; then
        # The OpenTelemetry Operator's own controller (field manager "manager") takes ownership
        # of some Instrumentation CR fields (e.g. .spec.env) when it defaults/mutates them, which
        # then conflicts with Helm's server-side apply on later upgrades that change those fields:
        # "UPGRADE FAILED: conflict occurred while applying object ...: conflict with "manager" ...".
        # Pass --force-conflicts to have Helm's server-side apply take ownership back.
        FORCE_CONFLICTS_ARGS=(--force-conflicts)
    else
        OVERLAY_VALUES_FILE="$arg"
    fi
done
OVERLAY_VALUES_ARGS=()
if [[ -n "$OVERLAY_VALUES_FILE" ]]; then
    [[ -f "$OVERLAY_VALUES_FILE" ]] || { echo "Overlay values file not found: $OVERLAY_VALUES_FILE" >&2; exit 1; }
    OVERLAY_VALUES_ARGS=(-f "$OVERLAY_VALUES_FILE")
fi

# Load environment variables from .env file if it exists
[[ -f "$SCRIPT_DIR/.env" ]] && source "$SCRIPT_DIR/.env"

if [[ ! -f "$SCRIPT_DIR/.env" ]]; then
    echo ".env file not found in folder $SCRIPT_DIR . Entering interactive setup..."

    read -p "Datadog Site (eg: 'datadoghq.eu'): " DD_SITE
    [[ -z "$DD_SITE" ]] && error "Datadog Site cannot be empty"

    read -r -s -p "Datadog API Key (eg: '1234...'): " DD_API_KEY
    echo
    [[ -z "$DD_API_KEY" ]] && error "Datadog API Key cannot be empty"

    # Optional: the Datadog Operator needs an application key to manage the Datadog Agent
    # from Datadog Fleet Automation (see the Datadog Operator installation below).
    read -r -s -p "Datadog Application Key, optional, to manage the Agent from Fleet Automation (leave empty to skip): " DD_APP_KEY
    echo

    # Ask if user wants to save to .env file
    read -p "Save credentials to .env file? (y/n): " SAVE_TO_ENV
    if [[ "$SAVE_TO_ENV" == "y" || "$SAVE_TO_ENV" == "Y" ]]; then
        # Save to .env file
        {
            echo "export DD_SITE=\"${DD_SITE}\""
            echo "export DD_API_KEY=\"${DD_API_KEY}\""
            [[ -n "$DD_APP_KEY" ]] && echo "export DD_APP_KEY=\"${DD_APP_KEY}\""
        } >> "$SCRIPT_DIR/.env"
        chmod 600 "$SCRIPT_DIR/.env"
        echo "$SCRIPT_DIR/.env file created successfully."
    fi
fi

# Verify all required credentials are set
[[ -z "${DD_API_KEY:-}" ]] && error "DD_API_KEY is not set"

echo ""
echo "Collecting deployment configuration..."
echo ""

echo "Kubernetes Cluster Type:"
PS3="Select the Kubernetes cluster type (enter a number): "
select KUBE_CLUSTER_TYPE in "Amazon Elastic Kubernetes Service (EKS)" "Google Kubernetes Engine (GKE)" "Azure Kubernetes Service (AKS)" "Other"; do
    [[ -n "$KUBE_CLUSTER_TYPE" ]] && break
    echo "Invalid selection, please try again."
done

RESOURCE_DETECTION_AKS_ENABLED=false
RESOURCE_DETECTION_EKS_ENABLED=false
RESOURCE_DETECTION_GCP_ENABLED=false

case "$KUBE_CLUSTER_TYPE" in
    "Amazon Elastic Kubernetes Service (EKS)") K8S_MANAGED_SERVICE_DETECTOR="eks" ; RESOURCE_DETECTION_EKS_ENABLED=true ;;
    "Google Kubernetes Engine (GKE)") K8S_MANAGED_SERVICE_DETECTOR="gcp" ; RESOURCE_DETECTION_GCP_ENABLED=true ;;
    "Azure Kubernetes Service (AKS)") K8S_MANAGED_SERVICE_DETECTOR="aks" ; RESOURCE_DETECTION_AKS_ENABLED=true ;;
    *) K8S_MANAGED_SERVICE_DETECTOR="" ;;
esac
export K8S_MANAGED_SERVICE_DETECTOR


# The Datadog Agent only accepts lowercase letters, digits, "-" and "." in cluster names (no
# uppercase, no "_"): it rewrites "_" to "-" and ignores names with uppercase letters.
K8S_CLUSTER_NAME="unknown-k8s-cluster"
if [[ "$KUBE_CLUSTER_TYPE" == "Other" ]]; then
    read -p "Kubernetes Cluster Name (default: 'unknown-k8s-cluster'): " K8S_CLUSTER_NAME
    K8S_CLUSTER_NAME=${K8S_CLUSTER_NAME:-unknown-k8s-cluster}
    NORMALIZED_K8S_CLUSTER_NAME=$(echo "$K8S_CLUSTER_NAME" | tr '[:upper:]_' '[:lower:]-')
    if [[ "$NORMALIZED_K8S_CLUSTER_NAME" != "$K8S_CLUSTER_NAME" ]]; then
        echo "Using cluster name '$NORMALIZED_K8S_CLUSTER_NAME' instead of '$K8S_CLUSTER_NAME' (lowercase, '-' instead of '_')."
        K8S_CLUSTER_NAME="$NORMALIZED_K8S_CLUSTER_NAME"
    fi
else
  # k8s.cluster.name will be auto-detected by the OpenTelemetry Collector Resource Detection Processor
  # based on the cloud provider detector (eks, gcp, aks)
  K8S_CLUSTER_NAME=""
fi
export K8S_CLUSTER_NAME

read -p "Deployment Environment Name like 'production', 'staging'... (default: 'production'): " DEPLOYMENT_ENVIRONMENT_NAME
export DEPLOYMENT_ENVIRONMENT_NAME=${DEPLOYMENT_ENVIRONMENT_NAME:-production}

# The eBPF host profiler needs Linux nodes with kernel >= 5.10 and runs one
# collector per node with eBPF capabilities. Off by default: it is a security
# decision, not a configuration detail.
read -p "Enable the eBPF host profiler? (requires Linux nodes, kernel >= 5.10) (y/N): " ENABLE_HOST_PROFILER
export ENABLE_HOST_PROFILER=${ENABLE_HOST_PROFILER:-N}
HOST_PROFILER_NETWORK_POLICY_FILE=""

if [[ "$ENABLE_HOST_PROFILER" == "y" || "$ENABLE_HOST_PROFILER" == "Y" ]]; then
    # Egress policy for the profiler, only useful on default-deny clusters
    # whose CNI enforces NetworkPolicy.
    read -p "Egress NetworkPolicy? (n)one / (s)tandard / (c)ilium (default: none): " HOST_PROFILER_NETWORK_POLICY
    case "${HOST_PROFILER_NETWORK_POLICY:-n}" in
        s*) HOST_PROFILER_NETWORK_POLICY_FILE="$SCRIPT_DIR/host-profiler-network-policy.yaml" ;;
        c*) HOST_PROFILER_NETWORK_POLICY_FILE="$SCRIPT_DIR/host-profiler-cilium-network-policy.yaml" ;;
    esac
    HOST_PROFILER_ENABLED_ARGS=(
        --set collectors.host-profiler.enabled=true
        -f "$SCRIPT_DIR/host-profiler-rbac-values.yaml"
    )
fi
echo ""

#### BEGINNING OF INSTALLATION SCRIPT

# WARNING: dont change "namespace=opentelemetry-operator-system" as it is used in the 'instrumentation' CRD defined in values.yaml

echo "Creating Kubernetes namespaces..."

kubectl create namespace opentelemetry-operator-system || echo "WARNING: Could not create namespace 'opentelemetry-operator-system' (may already exist or insufficient permissions). Continuing..."
# The Datadog Operator and the DatadogAgent custom resource live in their own
# "datadog" namespace, separate from the OpenTelemetry Kube Stack.
kubectl create namespace datadog || echo "WARNING: Could not create namespace 'datadog' (may already exist or insufficient permissions). Continuing..."

echo "Creating or updating Datadog secret..."

# The secret is duplicated in both namespaces: opentelemetry-operator-system's
# copy is used by the Datadog exporter in the OTel collectors (see values.yaml),
# and datadog's copy is used by the DatadogAgent custom resource and the Datadog
# Operator. Only datadog's copy holds the (optional) application key.
for DD_SECRET_NAMESPACE in opentelemetry-operator-system datadog; do
    DD_APP_KEY_SECRET_ARGS=()
    if [[ "$DD_SECRET_NAMESPACE" == "datadog" && -n "${DD_APP_KEY:-}" ]]; then
        DD_APP_KEY_SECRET_ARGS=(--from-literal="app-key=$DD_APP_KEY")
    fi
    kubectl create secret generic datadog-secret \
      --namespace "$DD_SECRET_NAMESPACE"  \
      --from-literal="api-key=$DD_API_KEY" \
      --from-literal="dd-site=${DD_SITE:-datadoghq.com}" \
      ${DD_APP_KEY_SECRET_ARGS[@]+"${DD_APP_KEY_SECRET_ARGS[@]}"} \
      --dry-run=client -o yaml | kubectl apply -f -
done

echo "Configuring and updating Helm"

helm repo add open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts
helm repo add jetstack       https://charts.jetstack.io
helm repo add datadog        https://helm.datadoghq.com
helm repo update

echo "Installing cert-manager (if not already installed)..."

helm install cert-manager jetstack/cert-manager \
  --namespace cert-manager --create-namespace \
  --set crds.enabled=true  \
  --wait --timeout 5m \
  || echo "WARNING: Could not install cert-manager (may already exist or insufficient permissions). Continuing..."

echo "Installing OpenTelemetry Kube Stack Helm Chart..."

# Uninstall the legacy standalone host-profiler release first: two eBPF
# profilers must not run concurrently on the same node. If the upgrade below
# fails, re-run this script to get profiling back.
helm status host-profiler --namespace opentelemetry-operator-system >/dev/null 2>&1 \
  && helm uninstall host-profiler --namespace opentelemetry-operator-system \
  || echo "WARNING: No legacy host-profiler Helm release found. Continuing..."


# FIXME use deployment.environment.name, it's a workaround for https://github.com/DataDog/dd-trace-java/pull/12324
HELM_SET_ARGS=(
    --set-string "resourceAttributes.deployment\.environment=$DEPLOYMENT_ENVIRONMENT_NAME"
    --set-string "resourceAttributes.deployment\.environment\.name=$DEPLOYMENT_ENVIRONMENT_NAME"
    --set defaultCRConfig.presets.resourceDetection.aks.enabled=$RESOURCE_DETECTION_AKS_ENABLED
    --set defaultCRConfig.presets.resourceDetection.eks.enabled=$RESOURCE_DETECTION_EKS_ENABLED
    --set defaultCRConfig.presets.resourceDetection.gcp.enabled=$RESOURCE_DETECTION_GCP_ENABLED
)

if [[ -n "$K8S_CLUSTER_NAME" ]]; then
    HELM_SET_ARGS+=(--set-string "resourceAttributes.k8s\.cluster\.name=$K8S_CLUSTER_NAME")
fi

helm upgrade opentelemetry-kube-stack \
    open-telemetry/opentelemetry-kube-stack \
    --version 0.21.0 \
    --install \
    --namespace opentelemetry-operator-system \
    "${FORCE_CONFLICTS_ARGS[@]}" \
    "${HELM_SET_ARGS[@]}" \
    -f "$SCRIPT_DIR/values.yaml" \
    ${HOST_PROFILER_ENABLED_ARGS[@]+"${HOST_PROFILER_ENABLED_ARGS[@]}"} \
    ${OVERLAY_VALUES_ARGS[@]+"${OVERLAY_VALUES_ARGS[@]}"}

# The standard and Cilium policies select the same pods and Kubernetes
# NetworkPolicies are additive: remove both NetworkPolicy before applying
# the selected one (or none), so a policy from a previous run cannot widen
# the requested egress.
kubectl delete networkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  opentelemetry-kube-stack-host-profiler-egress \
  || echo "WARNING: Could not delete the host-profiler NetworkPolicy. Continuing..."
kubectl delete ciliumnetworkpolicy \
  --namespace opentelemetry-operator-system \
  --ignore-not-found=true \
  opentelemetry-kube-stack-host-profiler-egress \
  || echo "WARNING: CiliumNetworkPolicy CRD not installed. Continuing..."

if [[ -n "$HOST_PROFILER_NETWORK_POLICY_FILE" ]]; then
    echo "Applying the host-profiler egress NetworkPolicy..."
    kubectl apply -f "$HOST_PROFILER_NETWORK_POLICY_FILE" \
      || echo "WARNING: Could not apply the host-profiler egress NetworkPolicy (is Cilium installed if you chose the Cilium policy?). Continuing..."
fi

# Uninstall the legacy Datadog Agent Helm release (the Datadog Agent used to be
# installed with the datadog/datadog Helm chart in the opentelemetry-operator-system
# namespace): two Datadog Agent DaemonSets must not run on the same node.
helm status ddagent-kube-stack --namespace opentelemetry-operator-system >/dev/null 2>&1 \
  && helm uninstall ddagent-kube-stack --namespace opentelemetry-operator-system --wait \
  || echo "WARNING: No legacy ddagent-kube-stack Helm release found. Continuing..."

echo "Installing Datadog Operator..."

# The Operator's own identity (API key, site and cluster name), used for its telemetry and
# metadata. Without them, the Operator falls back to the DatadogAgent's credentials and settings.
OPERATOR_HELM_ARGS=(
    --set apiKeyExistingSecret=datadog-secret
    --set-string site="${DD_SITE:-datadoghq.com}"
)
if [[ -n "$K8S_CLUSTER_NAME" ]]; then
    OPERATOR_HELM_ARGS+=(--set-string clusterName="$K8S_CLUSTER_NAME")
fi

# Fleet Automation: with an application key, the Operator connects to Datadog Remote
# Configuration so the Datadog Agent can be managed from Datadog:
# - remoteConfiguration.enabled: enable/disable Agent features (e.g. from the Datadog UI),
# - previewFleetRollouts: apply Fleet Automation configuration changes to the DatadogAgent
#   (Preview, request access for your org at
#   https://www.datadoghq.com/product-preview/configure-agent-kubernetes-operator/).
if [[ -n "${DD_APP_KEY:-}" ]]; then
    echo "Enabling Fleet Automation (Remote Configuration) in the Datadog Operator..."
    OPERATOR_HELM_ARGS+=(
        --set appKeyExistingSecret=datadog-secret
        --set remoteConfiguration.enabled=true
        --set previewFleetRollouts=true
    )
    if [[ -z "$K8S_CLUSTER_NAME" ]]; then
        echo "WARNING: No cluster name set (EKS/GKE/AKS): the Datadog Operator's Remote Configuration requires one." \
             "Choose 'Other' and enter the cluster name to enable Fleet Automation."
    fi
else
    echo "DD_APP_KEY not set: Fleet Automation (managing the Agent from Datadog) is disabled." \
         "Add 'export DD_APP_KEY=...' to $SCRIPT_DIR/.env and re-run this script to enable it."
fi

helm upgrade datadog-operator \
    datadog/datadog-operator \
    --install \
    --namespace datadog \
    ${OPERATOR_HELM_ARGS[@]+"${OPERATOR_HELM_ARGS[@]}"} \
    --wait --timeout 5m

echo "Applying the DatadogAgent custom resource..."

# On EKS/GKE/AKS, K8S_CLUSTER_NAME is empty: drop the `clusterName` line so the Datadog Agent
# auto-detects the cluster name from the cloud provider. An empty `clusterName: ""` isn't enough,
# the Operator would still set DD_CLUSTER_NAME on the agent containers.
if [[ -n "$K8S_CLUSTER_NAME" ]]; then
    CLUSTER_NAME_SED_ARGS=(-e "s|<CLUSTER_NAME>|$K8S_CLUSTER_NAME|")
else
    CLUSTER_NAME_SED_ARGS=(-e "/<CLUSTER_NAME>/d")
fi

sed \
  "${CLUSTER_NAME_SED_ARGS[@]}" \
  -e "s|<DD_SITE>|${DD_SITE:-datadoghq.com}|" \
  "$SCRIPT_DIR/datadog-agent.yaml" \
  | kubectl apply --namespace datadog -f -
